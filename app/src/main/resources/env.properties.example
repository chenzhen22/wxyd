# 环境配置模板 — 复制为 env.properties 并填入真实值（env.properties 已 gitignore，永不提交）
# SM4 密钥生成：运行 SMUtil.generateSM4Key() 得到 32 位 hex（16 字节），填入 wxyd.sm4.key

# 数据源
datasource.url=jdbc:mysql://<host>:<port>/<db>?useSSL=false&characterEncoding=utf8&serverTimezone=Asia/Shanghai
datasource.username=<db_user>
datasource.password=<db_password>

# 国密 SM4 密钥（16 字节，32 位 hex）— 加密用户密码与机器人 SECRET
wxyd.sm4.key=<32_hex_chars_from_SMUtil.generateSM4Key>

# 超级管理员初始账号（首次启动且 users 表为空时播种；之后请改密）
wxyd.admin.username=admin
wxyd.admin.password=<initial_admin_password>

# GitHub OAuth 登录（可选；三项都填才启用，留空则登录页不接入）
# 在 GitHub → Settings → Developer settings → OAuth Apps 创建应用，
# Authorization callback URL 必须与 wxyd.github.redirect-uri 完全一致
wxyd.github.client-id=<github_oauth_app_client_id>
wxyd.github.client-secret=<github_oauth_app_client_secret>
wxyd.github.redirect-uri=https://<你的域名>/api/oauth/github/callback
# 可选：若服务器出网无法直连 github.com（常见于国内环境），可指向一台能访问 GitHub 的 HTTP 代理
wxyd.github.proxy-host=
wxyd.github.proxy-port=

# Gitee OAuth 登录（可选；三项都填才启用，留空则登录页不接入）
# 在 Gitee → 设置 → 安全设置 → 私人令牌/第三方应用（https://gitee.com/oauth/applications）创建应用，
# 回调地址必须与 wxyd.gitee.redirect-uri 完全一致；应用权限勾选 user_info
wxyd.gitee.client-id=<gitee_oauth_app_client_id>
wxyd.gitee.client-secret=<gitee_oauth_app_client_secret>
wxyd.gitee.redirect-uri=https://<你的域名>/api/oauth/gitee/callback

# SMTP 邮箱注册发信（邮箱注册验证码；留空则发码接口报"SMTP 未配置"）
# 以 QQ 邮箱为例：host=smtp.qq.com port=465 username=QQ号@qq.com password=授权码（非登录密码）
wxyd.smtp.host=
wxyd.smtp.port=465
wxyd.smtp.username=
wxyd.smtp.password=
# 发件人地址，留空默认取 wxyd.smtp.username
wxyd.smtp.from=

# 福利专区（可选）：dataScan 抓取图片的落地目录，须与 dataScan 的 files.image_dir 一致
# 留空用默认值 /apps/shareFile/datascan；目录内容经 /api/welfare-img/** 映射（需登录）
wxyd.welfare.image-dir=

# 金融日报推送（/common/dayinfo.do）：两项都填才启用；调用方持公钥+SM4密钥
# SM2 密钥对：SMUtil.generateSM2KeyPair() → [0]=私钥填这里，[1]=公钥发给推送方
# SM4 密钥：SMUtil.generateSM4Key()，与推送方共用（加签 sign=SM4-ECB(SM3(data+timestamp))）
wxyd.dayinfo.sm2-private-key=
wxyd.dayinfo.sm4-key=
# 可选：日报分享链接基地址（如 https://域名/api），配置后钉钉/邮件推送附免登录查看链接；留空不带链接
wxyd.dayinfo.base-url=
# 可选：订阅提醒发送时间窗口（小时），默认 8-22 点；窗口外入库的日报顺延到窗口内推送
wxyd.dayinfo.notify-window-start=8
wxyd.dayinfo.notify-window-end=22

# AI 工具模型网关（/api/anthropic/** 与 /api/openai/**，Key 在页面「模型网关」里创建，无需在此配置）
# 上游为 WorkBuddy 桌面 App 登录态（copilot.tencent.com 私有接口）：凭据解密必须经 WSL interop
# 调 Windows 侧 node.exe 执行 win-bridge.mjs（dsh-claude-gateway 项目自带）。以下全部可留空用默认值。
# Windows node 的 WSL 路径（interop 桥接用；留空依次尝试 PATH 里的 node.exe 与常见安装位置）
wxyd.wbgateway.win-node=/mnt/c/Program Files/nodejs/node.exe
# win-bridge.mjs 的路径（/mnt/x/... 或 X:\... 形式；默认指向 dsh-claude-gateway 项目）
wxyd.wbgateway.win-bridge-script=/mnt/d/app/dsh-claude-gateway/workbuddy/win-bridge.mjs
# 凭据缓存时长（分钟）；令牌被上游判死会自动失效重取
wxyd.wbgateway.bridge-ttl-minutes=10
# 未知模型/用户未自选时的默认模型（须在 WorkBuddy 目录内）
wxyd.wbgateway.default-model=glm-5.3
# 用量记录保留天数（wb_gateway_usage 只保留 N 天，每日 03:30 清理）
wxyd.wbgateway.usage-retention-days=7
# 桌面 App 版本号（拼进 chat 请求 User-Agent；与插件兜底值一致）
wxyd.wbgateway.client-version=5.5.6
# WorkBuddy 桌面 App 安装在非默认路径时指定（Windows 风格路径，如 D:\Program Files\WorkBuddy\WorkBuddy.exe）
wxyd.wbgateway.electron-bin=
