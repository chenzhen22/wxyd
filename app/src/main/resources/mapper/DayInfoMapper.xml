<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyz.mapper.mysqlMapper.DayInfoMapper">

	<sql id="cols">
		`id`,`type`,date_format(`info_date`,'%Y-%m-%d') as `info_date`,`title`,`content`,`brief`,
		date_format(`create_time`,'%Y-%m-%d %H:%i') as `create_time`,
		date_format(`update_time`,'%Y-%m-%d %H:%i') as `update_time`
	</sql>

	<select id="getByTypeAndDate" resultType="com.cyz.pojo.DayInfo">
		select <include refid="cols"/> from `day_info`
		where `type`=#{type} and `info_date`=#{infoDate}
	</select>

	<insert id="insert" parameterType="com.cyz.pojo.DayInfo" useGeneratedKeys="true" keyProperty="id">
		insert into `day_info` (`type`,`info_date`,`title`,`content`,`brief`)
		values (#{type},#{infoDate},#{title},#{content},#{brief})
	</insert>

	<update id="updateContent" parameterType="com.cyz.pojo.DayInfo">
		update `day_info` set `title`=#{title}, `content`=#{content}, `brief`=#{brief} where `id`=#{id}
	</update>

	<select id="listByType" resultType="com.cyz.pojo.DayInfo">
		select <include refid="cols"/> from `day_info`
		where `type`=#{type}
		order by `info_date` desc
		limit #{offset}, #{pageSize}
	</select>

	<select id="countByType" resultType="Integer">
		select count(1) from `day_info` where `type`=#{type}
	</select>

	<select id="getById" resultType="com.cyz.pojo.DayInfo">
		select <include refid="cols"/> from `day_info` where `id`=#{id}
	</select>

	<select id="getLatest" resultType="com.cyz.pojo.DayInfo">
		select <include refid="cols"/> from `day_info`
		where `type`=#{type}
		order by `info_date` desc limit 1
	</select>

	<sql id="subCols">
		`s`.`id`,`s`.`user_id`,`s`.`channel`,`s`.`robot_id`,`s`.`email`,`s`.`enabled`,
		date_format(`s`.`create_time`,'%Y-%m-%d %H:%i') as `create_time`,
		date_format(`s`.`update_time`,'%Y-%m-%d %H:%i') as `update_time`
	</sql>

	<select id="listByUser" resultType="com.cyz.pojo.DayInfoSubscribe">
		select <include refid="subCols"/> from `day_info_subscribe` `s`
		where `s`.`user_id`=#{userId} order by `s`.`id` desc
	</select>

	<select id="getSubById" resultType="com.cyz.pojo.DayInfoSubscribe">
		select <include refid="subCols"/> from `day_info_subscribe` `s` where `s`.`id`=#{id}
	</select>

	<insert id="insertSubscribe" parameterType="com.cyz.pojo.DayInfoSubscribe" useGeneratedKeys="true" keyProperty="id">
		insert into `day_info_subscribe` (`user_id`,`channel`,`robot_id`,`email`,`enabled`)
		values (#{userId},#{channel},#{robotId},#{email},#{enabled})
	</insert>

	<!-- 双重限定：id 归属校验在 SQL 层兜底，杜绝删别人的订阅 -->
	<delete id="deleteSubscribe">
		delete from `day_info_subscribe` where `id`=#{id} and `user_id`=#{userId}
	</delete>

	<update id="updateSubscribeEnabled">
		update `day_info_subscribe` set `enabled`=#{enabled} where `id`=#{id} and `user_id`=#{userId}
	</update>

	<select id="countByUser" resultType="Integer">
		select count(1) from `day_info_subscribe` where `user_id`=#{userId}
	</select>

	<select id="listEnabledSubscribe" resultType="com.cyz.pojo.DayInfoSubscribe">
		select <include refid="subCols"/> from `day_info_subscribe` `s` where `s`.`enabled`=1
	</select>

</mapper>
