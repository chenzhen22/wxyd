<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyz.mapper.mysqlMapper.MysqlMapper">

	<update id="addMessage" parameterType="com.cyz.pojo.Messages">
		INSERT INTO `message` (`ip`,`info`,`time`) VALUES (#{ip},#{info},now())
	</update>

	<update id="delMessage" parameterType="String">
		DELETE FROM `message` where `id` = #{msgId}
	</update>

	<select id="queryMessage" parameterType="String" resultType="java.util.HashMap">
		select `id`,`ip`,`info`,date_format(`time`,'%Y-%m-%d %H:%i:%s') as "time" from `message`
		<where>
			<if test="msgId != null and msgId != ''">
				`id` = #{msgId}
			</if>
			<if test="requetIp != null and requetIp != ''">
				and `ip` = #{requetIp}
			</if>
		</where>
		order by `id` desc limit 200
	</select>

	<select id="queryMessageCount" resultType="Integer">
		select count(1) from `message`
	</select>

	<select id="getUserName" resultType="String" parameterType="String">
		select username from client where ip =#{clientIp}
	</select>

	<select id="getUserNameByStatus" resultType="String" parameterType="String">
		select username from client where ip =#{clientIp} and status='0'
	</select>


	<select id="queryClientInfo" resultType="java.util.HashMap">
		select ip,username,status from client
	</select>

	<select id="queryWhiteUrl" resultType="Integer" parameterType="String">
		select count(1) from `action` where `actions`=#{url}
	</select>

	<select id="queryWhiteInfo" resultType="com.cyz.pojo.WhiteUser" parameterType="com.cyz.pojo.WhiteUser">
		select ip,status,username from client
		<where>
			<if test="userName != null and userName != ''">
				and username like CONCAT('%', #{userName}, '%')
			</if>
			<if test="ip != null and ip != ''">
				and ip=#{ip}
			</if>
		</where>
	</select>

	<update id="addWhite" parameterType="com.cyz.pojo.WhiteUser">
		insert into client values (#{ip},#{status},#{userName})
	</update>

	<update id="updateWhiteByUsername" parameterType="com.cyz.pojo.WhiteUser">
		update client set status=#{status} where username=#{userName}
	</update>


	<update id="updateWhiteByIp" parameterType="com.cyz.pojo.WhiteUser">
		update client set username=#{userName} where ip=#{ip}
	</update>


	<update id="deleteWhite" parameterType="com.cyz.pojo.WhiteUser">
		delete from client where username=#{userName}
	</update>

	<insert id="addLog" parameterType="com.cyz.pojo.LogPojo">
		insert into requestlog values (#{clientIp},#{url},#{data},now());
	</insert>

	<!-- ===== users ===== -->
	<select id="countUsers" resultType="Integer">
		select count(1) from `users`
	</select>

	<insert id="insertUser" parameterType="com.cyz.pojo.User" useGeneratedKeys="true" keyProperty="id">
		insert into `users` (`username`,`password`,`display_name`,`role`,`status`) values (#{username},#{password},#{displayName},#{role},#{status})
	</insert>

	<select id="queryUserByUsername" parameterType="String" resultType="com.cyz.pojo.User">
		select `id`,`username`,`password`,`display_name`,`role`,`status`,date_format(`create_time`,'%Y-%m-%d %H:%i:%s') as createTime from `users` where `username`=#{username}
	</select>

	<select id="queryUserById" parameterType="Long" resultType="com.cyz.pojo.User">
		select `id`,`username`,`display_name`,`role`,`status`,date_format(`create_time`,'%Y-%m-%d %H:%i:%s') as createTime from `users` where `id`=#{id}
	</select>

	<select id="listUsers" resultType="com.cyz.pojo.User">
		select `id`,`username`,`display_name`,`role`,`status`,date_format(`create_time`,'%Y-%m-%d %H:%i:%s') as createTime from `users` order by `status`,`id`
	</select>

	<update id="updateUserStatus">
		update `users` set `status`=#{status} where `id`=#{id}
	</update>

	<delete id="deleteUser" parameterType="Long">
		delete from `users` where `id`=#{id}
	</delete>

	<!-- ===== ding_robot ===== -->
	<insert id="insertRobot" parameterType="com.cyz.pojo.DingRobot" useGeneratedKeys="true" keyProperty="id">
		insert into `ding_robot` (`user_id`,`name`,`access_token`,`secret`) values (#{userId},#{name},#{accessToken},#{secret})
	</insert>

	<select id="queryRobotById" parameterType="Long" resultType="com.cyz.pojo.DingRobot">
		select `id`,`user_id`,`name`,`access_token`,`secret`,date_format(`create_time`,'%Y-%m-%d %H:%i:%s') as createTime from `ding_robot` where `id`=#{id}
	</select>

	<select id="listRobotsByUserId" parameterType="Long" resultType="com.cyz.pojo.DingRobot">
		select `id`,`user_id`,`name`,`access_token`,date_format(`create_time`,'%Y-%m-%d %H:%i:%s') as createTime from `ding_robot` where `user_id`=#{userId} order by `id`
	</select>

	<update id="updateRobot" parameterType="com.cyz.pojo.DingRobot">
		update `ding_robot` set `name`=#{name},`access_token`=#{accessToken}
		<if test="secret != null and secret != ''">
			,`secret`=#{secret}
		</if>
		where `id`=#{id} and `user_id`=#{userId}
	</update>

	<delete id="deleteRobot">
		delete from `ding_robot` where `id`=#{id} and `user_id`=#{userId}
	</delete>

</mapper>
